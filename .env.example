DB_NAME=campusclaw
DB_USER=campusclaw
DB_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
SESSION_SECRET=REPLACE_WITH_RANDOM_STRING_AT_LEAST_32_CHARS
SEED_TEACHER_A_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SEED_STUDENT_A_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SEED_TEACHER_B_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SEED_STUDENT_B_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
WEB_PORT=8080
COOKIE_SECURE=false
# Lesson 4 defaults use the private deterministic demo gateway; for a real course gateway override these:
# GATEWAY_BASE_URL=https://your-course-gateway.example/v1
# GATEWAY_API_KEY=REPLACE_WITH_COURSE_KEY
# EMBEDDING_MODEL=your-embedding-model
# CHAT_MODEL=your-chat-model
# EMBEDDING_DIM=64

# 第5课：仅替换助手的对话模型，可保留现有嵌入/Qdrant索引
# CHAT_GATEWAY_BASE_URL=https://your-compatible-gateway.example/v1
# CHAT_GATEWAY_API_KEY=your-chat-key
# CHAT_MODEL=your-streaming-chat-model

# 第六课：API与同仓MCP服务共用，仅填写本机.env。32字符以上随机值。
MCP_AUTH_TOKEN=REPLACE_WITH_RANDOM_MCP_TOKEN_AT_LEAST_32_CHARS
MCP_ALLOWED_HOSTS=mcp-demo
MCP_MAX_ROUNDS=3
MCP_MAX_CALLS=4
